{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}



{% block content %}

    <h2>New Expense</h2>

    <form method = "post" action="/expense/new" class="expense-form">
        <label>Categories</label>
        <select name="category_id" required>
                
                <option value= "" disabled selected>   Choose category   </option>
            {% for categories in categories %}
                <option value="{{ categories.id }}">
                    {{ categories.name }} {{ categories.icon }}
                </option>
            {% endfor %}
        </select>

        <label>
            Amount
            <input type = "number" name="amount" required>
        </label>
    
        <label>
            Spend
            <input type = "number" name="spend" required>
        </label>

        <label>
            Date
            <input type = "date" name="date" value="{{ today }}"required>
        </label>

        <button><a href="/expense/list" class="back_feature"> Back</a> </button>
        <button> Add Expense </button>

    </form>

{% endblock %}

