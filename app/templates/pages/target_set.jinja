{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Set Your Weekly Target</h2>

    <div class="target_board">

        <h3>Add Target This Week</h3>

        <form method="POST" action="/target">

            <label>Weekly Target ($)</label>

            <input
                type="number"
                name="weekly_target"
                min="1"
                step="1"
                placeholder="Enter your target"
                required
            >

            <label>Week Start</label>

            <input
                type="date"
                name="date_week_start"
                value="{{ today }}"
                required
            >
            
    <div class="target_buttons">
        <a href="/" class="back-button">Back</a>

        <button type="submit" class="save-button">
            Save Target
        </button>
    </div>
        
        </form>

    </div>

{% endblock %}
